<mxfile host="app.diagrams.net" modified="2026-09-28T01:30:00.000Z" agent="Antigravity" version="24.7.5">
  <diagram id="diagram_1" name="CD-9 Evidence Upload & Verification">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="&lt;&lt;Architecture Note&gt;&gt;
Direct Client-to-Cloudinary Upload:
Frontend uploads evidence binaries directly to Cloudinary CDN.
Backend receives URL and metadata only (no file streams or SHA-256 hashing).
IStorageService removed in favor of Cloudinary REST storage." vertex="1"><mxGeometry x="50" y="40" width="370" height="80" as="geometry" /></mxCell>
        <mxCell id="c_ctrl" parent="1" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;rounded=0;" value="&lt;&lt;Controller&gt;&gt;
